# Local development settings. Copy to .env and fill in the values (.env is not committed).
# On Render these are set as environment variables instead (see README.md).

# production (default) | development | test
APP_ENV=development

# PostgreSQL connection. postgres:// and postgresql:// URLs are both accepted.
DATABASE_URL=postgresql://opinion_app:CHANGE_ME@127.0.0.1:5432/ecoforet_opinion

# Signs the admin session cookie and the completion-page receipt. 32+ random characters.
# e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Admin (/admin) password, 8 characters or more. Admin login stays disabled while this is empty.
ADMIN_PASSWORD=CHANGE_ME

# Optional: SQLAlchemy pool per process (defaults 5 + 10).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Optional, tests only: a database whose name ends in _test (tables are dropped and recreated).
# TEST_DATABASE_URL=postgresql://opinion_app:CHANGE_ME@127.0.0.1:5432/ecoforet_opinion_test
